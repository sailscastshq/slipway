<% /* Default layout for email templates */ %>
<div style="width: 100%; font-family: 'Inter','Helvetica','arial', sans-serif; box-sizing: border-box; padding: 0; margin: 0;">
  <div style="color: #192147; font-size: 16px; box-sizing: border-box; padding: 40px 60px 80px 28px; width: 100%; max-width: 600px; margin-left: auto; margin-right: auto;">
    <div style="background: transparent; text-align: left;">
    </div>
    <%- body %>
    <hr style="color: #E2E4EA;"/>
    <div style="text-align: left; padding-top: 15px; font-size: 12px; color: #3E4771;">
      <p style="margin: 0 0 6px 0;">Slipway &mdash; open-source deployment platform</p>
      <p style="margin: 0; font-size: 11px; color: #9ca3af;">
        <a href="https://github.com/sailscastshq/slipway" style="color: #9ca3af; text-decoration: none;">Star on GitHub</a>
        &nbsp;|&nbsp;
        <a href="https://github.com/sponsors/sailscastshq" style="color: #9ca3af; text-decoration: none;">Sponsor</a>
      </p>
    </div>
  </div>
</div>
