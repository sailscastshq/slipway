<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>Page not found | Slipway</title>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <style>
      :root {
        color-scheme: light;
        --page-background: #ffffff;
        --primary-text: #171717;
        --secondary-text: #737373;
        --button-background: #171717;
        --button-background-hover: #262626;
        --button-text: #ffffff;
        --logo-color: #0284c7;
        --focus-color: #0284c7;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
      }

      body {
        margin: 0;
        background: var(--page-background);
        color: var(--primary-text);
        font-family:
          ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      main {
        display: grid;
        min-height: 100vh;
        min-height: 100svh;
        place-items: center;
        padding: 2rem 1.5rem;
      }

      .error-page {
        width: min(100%, 28rem);
        text-align: center;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        margin-bottom: 3.5rem;
        color: var(--primary-text);
        font-size: 1.125rem;
        font-weight: 600;
        letter-spacing: -0.015em;
        text-decoration: none;
      }

      .brand svg {
        width: 2rem;
        height: 2rem;
        color: var(--logo-color);
      }

      .status {
        margin: 0 0 0.75rem;
        color: var(--secondary-text);
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.08em;
      }

      h1 {
        margin: 0;
        font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
        font-weight: 650;
        letter-spacing: -0.035em;
        line-height: 1.15;
        text-wrap: balance;
      }

      .message {
        max-width: 25rem;
        margin: 1rem auto 0;
        color: var(--secondary-text);
        font-size: 1rem;
        line-height: 1.65;
        text-wrap: pretty;
      }

      .actions {
        margin-top: 2rem;
      }

      .primary-action {
        display: inline-flex;
        min-height: 3rem;
        align-items: center;
        justify-content: center;
        border-radius: 0.375rem;
        background: var(--button-background);
        color: var(--button-text);
        font-size: 0.9375rem;
        font-weight: 600;
        padding: 0.75rem 1.125rem;
        text-decoration: none;
        transition: background-color 150ms ease;
      }

      .primary-action:hover {
        background: var(--button-background-hover);
      }

      a:focus-visible {
        outline: 2px solid var(--focus-color);
        outline-offset: 3px;
      }

      @media (max-width: 30rem) {
        .brand {
          margin-bottom: 3rem;
        }

        .primary-action {
          width: 100%;
        }
      }

      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
          --page-background: #000000;
          --primary-text: #fafafa;
          --secondary-text: #a3a3a3;
          --button-background: #fafafa;
          --button-background-hover: #e5e5e5;
          --button-text: #0a0a0a;
          --logo-color: #fafafa;
          --focus-color: #38bdf8;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .primary-action {
          transition: none;
        }
      }
    </style>
  </head>
  <body data-error-page="404">
    <main>
      <section class="error-page" aria-labelledby="error-heading">
        <a class="brand" href="/" aria-label="Go to Slipway">
          <svg
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M7 17 C7 3 25 3 25 17 Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M7 17 C4 21 4 25 8 28"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <path
              d="M12 17 C11 21 10 25 13 28"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <path
              d="M20 17 C21 21 22 25 19 28"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <path
              d="M25 17 C28 21 28 25 24 28"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <circle cx="13" cy="11" r="1.5" fill="currentColor" />
            <circle cx="19" cy="11" r="1.5" fill="currentColor" />
          </svg>
          <span>Slipway</span>
        </a>

        <p class="status">404</p>
        <h1 id="error-heading">Page not found</h1>
        <p class="message">
          The page may have moved, or the link may no longer be available.
        </p>

        <nav class="actions" aria-label="Recovery">
          <a class="primary-action" href="/">Return to Slipway</a>
        </nav>
      </section>
    </main>
  </body>
</html>
