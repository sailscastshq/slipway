<% /* Note: This is injected into `views/layouts/mail.ejs` */ %>
<div style="padding: 32px 32px 28px;">
  <h2 style="margin: 0 0 12px 0; color: #18181b; font-size: 20px; font-weight: 600; line-height: 1.3;">
    Reset your password
  </h2>
  <p style="color: #52525b; font-size: 14px; line-height: 1.7; margin: 0 0 28px 0;">
    No worries, it happens to the best of us! Tap below to pick a new password and you&rsquo;ll be back in action. If you didn&rsquo;t request this, just ignore this email &mdash; nothing will change.
  </p>
  <div style="margin-bottom: 28px;">
    <a href="<%= url.resolve(sails.config.custom.baseUrl, '/reset-password') + '?token=' + encodeURIComponent(token) %>" style="display: inline-block; background-color: #192147; color: #ffffff; text-decoration: none; padding: 12px 28px; border-radius: 8px; font-size: 14px; font-weight: 600; line-height: 1;">Reset password</a>
  </div>
  <p style="color: #a1a1aa; font-size: 12px; line-height: 1.6; margin: 0 0 20px 0;">
    If the button doesn&rsquo;t work, copy and paste this link into your browser:<br>
    <a href="<%= url.resolve(sails.config.custom.baseUrl, '/reset-password') + '?token=' + encodeURIComponent(token) %>" style="color: #3b82f6; word-break: break-all; font-size: 12px;"><%= url.resolve(sails.config.custom.baseUrl, '/reset-password') + '?token=' + encodeURIComponent(token) %></a>
  </p>
  <div style="border-top: 1px solid #f4f4f5; padding-top: 20px;">
    <p style="color: #a1a1aa; font-size: 12px; margin: 0;">&mdash; Slippy</p>
  </div>
</div>
