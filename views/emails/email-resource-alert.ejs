<div style="font-family: 'Inter', 'Helvetica', 'Arial', sans-serif; max-width: 600px; margin: 0 auto;">
  <div style="background-color: #f59e0b; height: 6px; border-radius: 3px 3px 0 0;"></div>
  <div style="padding: 24px;">
    <h2 style="margin: 0 0 20px 0; color: #192147; font-size: 20px; font-weight: 600;">
      High Resource Usage
    </h2>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
      <tr>
        <td style="padding: 10px 12px; border-bottom: 1px solid #E2E4EA; color: #3E4771; font-size: 13px; font-weight: 600; width: 120px;">Container</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #E2E4EA; color: #192147; font-size: 14px;"><%= containerName %></td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; border-bottom: 1px solid #E2E4EA; color: #3E4771; font-size: 13px; font-weight: 600;">CPU</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #E2E4EA; font-size: 14px; color: <%= cpuHigh ? '#ef4444' : '#192147' %>; font-weight: <%= cpuHigh ? '600' : 'normal' %>;"><%= cpuPercent %>%</td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; border-bottom: 1px solid #E2E4EA; color: #3E4771; font-size: 13px; font-weight: 600;">Memory</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #E2E4EA; font-size: 14px; color: <%= memHigh ? '#ef4444' : '#192147' %>; font-weight: <%= memHigh ? '600' : 'normal' %>;"><%= memoryPercent %>%</td>
      </tr>
    </table>
    <p style="color: #3E4771; font-size: 12px; margin: 0;">Sent from <%= instanceName %></p>
  </div>
</div>
