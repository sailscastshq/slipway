<div style="padding: 32px 32px 28px;">
  <div style="margin-bottom: 24px;">
    <span style="display: inline-block; background-color: #fffbeb; color: #d97706; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; padding: 4px 10px; border-radius: 20px;">Warning</span>
  </div>
  <h2 style="margin: 0 0 12px 0; color: #18181b; font-size: 20px; font-weight: 600; line-height: 1.3;">
    Things are heating up
  </h2>
  <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
    <tr>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; color: #a1a1aa; font-size: 13px; font-weight: 500; width: 110px; vertical-align: top;">Container</td>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; color: #18181b; font-size: 14px; font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;"><%= containerName %></td>
    </tr>
    <tr>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; color: #a1a1aa; font-size: 13px; font-weight: 500; vertical-align: top;">CPU</td>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; font-size: 14px; color: <%= cpuHigh ? '#dc2626' : '#18181b' %>; font-weight: <%= cpuHigh ? '600' : 'normal' %>;"><%= cpuPercent %>%</td>
    </tr>
    <tr>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; color: #a1a1aa; font-size: 13px; font-weight: 500; vertical-align: top;">Memory</td>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; font-size: 14px; color: <%= memHigh ? '#dc2626' : '#18181b' %>; font-weight: <%= memHigh ? '600' : 'normal' %>;"><%= memoryPercent %>%</td>
    </tr>
  </table>
  <p style="color: #52525b; font-size: 14px; line-height: 1.7; margin: 0 0 24px 0;">
    This container is working up a sweat! Resources have crossed the alert threshold &mdash; might be worth scaling up or investigating what&rsquo;s going on.
  </p>
  <div style="border-top: 1px solid #f4f4f5; padding-top: 20px;">
    <p style="color: #a1a1aa; font-size: 12px; margin: 0;">&mdash; Slippy, from <strong style="color: #71717a;"><%= instanceName %></strong></p>
  </div>
</div>
