<div style="font-family: 'Inter', 'Helvetica', 'Arial', sans-serif; max-width: 600px; margin: 0 auto;">
  <div style="background-color: #10b981; height: 6px; border-radius: 3px 3px 0 0;"></div>
  <div style="padding: 24px;">
    <h2 style="margin: 0 0 20px 0; color: #192147; font-size: 20px; font-weight: 600;">
      Test Notification
    </h2>
    <p style="color: #192147; font-size: 14px; line-height: 1.6; margin: 0 0 24px 0;">
      This is a test message from your Slipway instance. If you receive this, email notifications are working correctly.
    </p>
    <p style="color: #3E4771; font-size: 12px; margin: 0;">Sent from <%= instanceName %></p>
  </div>
</div>
