<%
  var durationFormatted = '';
  if (duration != null) {
    var totalSeconds = Math.round(duration / 1000);
    if (totalSeconds < 60) {
      durationFormatted = totalSeconds + 's';
    } else {
      var mins = Math.floor(totalSeconds / 60);
      var secs = totalSeconds % 60;
      durationFormatted = mins + 'm ' + secs + 's';
    }
  }
%>
<div style="padding: 32px 32px 28px;">
  <div style="margin-bottom: 24px;">
    <span style="display: inline-block; background-color: #fef2f2; color: #dc2626; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; padding: 4px 10px; border-radius: 20px;">Failed</span>
  </div>
  <h2 style="margin: 0 0 12px 0; color: #18181b; font-size: 20px; font-weight: 600; line-height: 1.3;">
    A job didn&rsquo;t finish
  </h2>
  <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
    <tr>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; color: #a1a1aa; font-size: 13px; font-weight: 500; width: 110px; vertical-align: top;">Job</td>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; color: #18181b; font-size: 14px; font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;"><%= jobName %></td>
    </tr>
    <% if (durationFormatted) { %>
    <tr>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; color: #a1a1aa; font-size: 13px; font-weight: 500; vertical-align: top;">Duration</td>
      <td style="padding: 10px 0; border-bottom: 1px solid #f4f4f5; color: #18181b; font-size: 14px;"><%= durationFormatted %></td>
    </tr>
    <% } %>
  </table>
  <% if (errorMessage) { %>
  <div style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 14px 16px; margin-bottom: 24px;">
    <p style="margin: 0 0 4px 0; color: #991b1b; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Error</p>
    <p style="margin: 0; color: #b91c1c; font-size: 13px; line-height: 1.5;"><%= errorMessage %></p>
  </div>
  <% } %>
  <div style="border-top: 1px solid #f4f4f5; padding-top: 20px;">
    <p style="color: #a1a1aa; font-size: 12px; margin: 0;">&mdash; Slippy, from <strong style="color: #71717a;"><%= instanceName %></strong></p>
  </div>
</div>
