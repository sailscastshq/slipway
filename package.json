{
  "name": "slipway",
  "version": "0.0.71",
  "private": true,
  "description": "The Sails-native deployment platform",
  "keywords": [
    "sails",
    "deployment",
    "paas",
    "docker"
  ],
  "workspaces": [
    "packages/*",
    "assets/js/videos"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@azure/storage-blob": "12.33.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@floating-ui/dom": "^1.8.0",
    "@inertiajs/vue3": "^3.4.0",
    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "^1.2.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sailscastshq/connect-sqlite": "^1.1.0",
    "@sailshq/connect-redis": "^6.1.3",
    "@sailshq/lodash": "^3.10.3",
    "@sailshq/socket.io-redis": "^6.1.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-file-handler": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "acorn": "^8.18.0",
    "chrono-node": "^2.10.1",
    "csrf": "^3.1.0",
    "dejavu-fonts-ttf": "2.37.3",
    "dompurify": "^3.4.15",
    "express-rate-limit": "^8.5.1",
    "inertia-sails": "^1.5.0",
    "marked": "^17.0.6",
    "mime-types": "^3.0.2",
    "nodemailer": "^10.0.0",
    "rsbuild-plugin-inertia": "^0.0.1",
    "sails": "^1.5.14",
    "sails-flash": "^0.0.1",
    "sails-hook-mail": "^0.2.2",
    "sails-hook-organics": "^3.0.0",
    "sails-hook-orm": "^4.0.3",
    "sails-hook-quest": "^0.0.5",
    "sails-hook-sockets": "^3.0.1",
    "sails-hook-uploads": "^0.4.3",
    "sails-sqlite": "^0.2.6",
    "sails-stash": "^0.2.0",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "^3.2.1",
    "vue": "^3.5.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rsbuild/plugin-vue": "^2.0.1",
    "create-sails-generator": "^1.0.0",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "sails-hook-dev": "^1.3.0",
    "sails-hook-shipwright": "^1.5.1",
    "sails.io.js": "^1.2.1",
    "socket.io-client": "^4.7.5",
    "sounding": "^0.2.0",
    "tailwindcss": "^4.1.16"
  },
  "scripts": {
    "dev": "node --watch-path=api --watch-path=config app.js",
    "local": "bash ./local.sh",
    "local:rebuild": "bash ./local.sh rebuild",
    "local:upgrade-check": "bash ./local.sh upgrade-check",
    "local:stop": "bash ./local.sh stop",
    "local:down": "bash ./local.sh down",
    "local:destroy": "bash ./local.sh destroy",
    "local:logs": "bash ./local.sh logs",
    "local:status": "bash ./local.sh status",
    "local:shell": "bash ./local.sh shell",
    "dev:proxy": "caddy run --config caddy.dev.json",
    "dev:proxy:trust": "caddy trust",
    "start": "NODE_ENV=production node app.js",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "audit:icons": "node scripts/audit-inline-icons.mjs",
    "check:consistency": "node scripts/check-docs-config-consistency.js",
    "test:unit": "sounding test --lane unit --test-concurrency=1",
    "test:functional": "sounding test --lane functional --test-concurrency=1",
    "test:e2e": "sounding test --lane e2e --test-concurrency=1 --test-timeout=600000",
    "test": "npm run test:unit && npm run test:functional && npm run test:e2e"
  },
  "main": "app.js",
  "engines": {
    "node": "^22.20.0 || >=24.12.0"
  },
  "overrides": {
    "b64": "npm:@hapi/b64@^6.0.1",
    "qs": "^6.16.0",
    "body-parser@1.20.5": "^1.20.6"
  }
}
