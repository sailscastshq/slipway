ARG BUILDER_IMAGE
FROM ${BUILDER_IMAGE}
WORKDIR /source
COPY . .
RUN npm ci --no-audit
ARG SOURCE_REVISION
ARG BUILDER_IMAGE
ARG SOURCE_DATE_EPOCH
RUN node scripts/package-upgrade-host.cjs /bundle "$SOURCE_REVISION" "$BUILDER_IMAGE" "$SOURCE_DATE_EPOCH" && \
    tar --sort=name --mtime="@$SOURCE_DATE_EPOCH" --owner=0 --group=0 --numeric-owner \
      --format=posix --pax-option=delete=atime,delete=ctime -cf - -C /bundle . \
      | gzip -n > /slipway-host.tar.gz
